# Obtain your own keys. Never share a populated .env.
# Buy a Seedance or Kling API key at https://chiensemodels.ai
CHIENSEMODELS_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
CHIENSEMODELS_BASE_URL=https://api.chiensemodels.ai/v1
# Generation model at Chiensemodels: seedance-2.5 (default) or kling
CHIENSEMODELS_MODEL=seedance-2.5
# Required by Chiensemodels. Leave blank to use the automatic cloudflared callback tunnel.
CHIENSEMODELS_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=
