# Obtain your own keys. Never share a populated .env.
# Buy a Seedance or Kling API key at https://chinesemodels.ai (keys start with sk-cm-)
CHINESEMODELS_API_KEY=
# Required for local preprocessing: Demucs vocals, colored depth and SAM 3 all run on Replicate.
REPLICATE_API_TOKEN=
# Optional, only for the Hugging Face depth alternative.
HF_TOKEN=
CHINESEMODELS_BASE_URL=https://chinesemodels.ai
# Editing model. Moon = bytedance/seedance-2.5/reference-to-video (edit task).
# SUMO = kwaivgi/kling-v4.0/video-edit. Switch by changing this one value.
CHINESEMODELS_MODEL=bytedance/seedance-2.5/reference-to-video
# Lowercase, exactly as the API requires: 480p | 720p | 1080p
# The draft pass runs at the preview resolution; the approved final pass runs at CHINESEMODELS_RESOLUTION.
CHINESEMODELS_PREVIEW_RESOLUTION=480p
CHINESEMODELS_RESOLUTION=1080p
